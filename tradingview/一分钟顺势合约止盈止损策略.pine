//@version=6
const float MARGIN_PERCENT = 20.0
const float FEE_PERCENT = 0.05
const int SLIPPAGE_TICKS = 2
strategy("一分钟顺势合约止盈止损策略", overlay = true, initial_capital = 1000,
     pyramiding = 0, default_qty_type = strategy.fixed, default_qty_value = 1,
     margin_long = MARGIN_PERCENT, margin_short = MARGIN_PERCENT,
     commission_type = strategy.commission.percent, commission_value = FEE_PERCENT,
     slippage = SLIPPAGE_TICKS, backtest_fill_limits_assumption = 1,
     process_orders_on_close = false, calc_on_every_tick = false, calc_on_order_fills = false)

// 一小时、十五分钟定方向，一分钟收盘触发；不使用未收盘的大级别数据。
// 成交警报消息：{{strategy.order.alert_message}}。这是模拟成交，不是交易所托管保护单。
// 止损与止盈在提交开仓时同时挂出；跳数固定，相对实际模拟成交价计算，不扩大止损。
// 属性里的保证金、手续费、滑点请保持与上方常量一致，否则计划数量与成本估算不同步。
// 普通成交量只作量能筛选，不冒充主动成交 Delta、CVD、盘口或爆仓数据。

// 共同信号开始：配套指标保持此段一致。
float slopeThreshold = input.float(0.03, "大级别每根均线变化 / ATR 下限", minval = 0, step = 0.01, group = "方向")
int signalWindow = input.int(3, "均线与 MACD 交叉最大间隔（根）", minval = 0, maxval = 10, group = "执行")
int pullbackWindow = input.int(5, "最近缩量回踩有效期（根）", minval = 1, maxval = 20, group = "执行")
float volumeMultiple = input.float(1.2, "触发成交量 / 前二十根均量", minval = 1, step = 0.1, group = "执行")
bool useVwap = input.bool(false, "额外要求价格位于日内 VWAP 顺势一侧", group = "执行")
int swingLength = input.int(5, "止损参考最近高低点根数", minval = 2, maxval = 30, group = "止盈止损")
float atrMultiple = input.float(1.5, "止损距离至少为 ATR14 的倍数", minval = 1, step = 0.1, group = "止盈止损")
float minStopPercent = input.float(0.15, "最小止损距离（价格 %）", minval = 0.05, step = 0.05, group = "止盈止损")
float maxStopPercent = input.float(0.6, "最大止损距离（价格 %，超出不入场）", minval = 0.1, maxval = 2, step = 0.05, group = "止盈止损")
float netRR = input.float(2, "止盈目标的计划净盈亏比", minval = 2, maxval = 5, step = 0.1, group = "止盈止损")
float maxTargetPercent = input.float(2, "最大目标距离（价格 %，超出不入场）", minval = 0.2, maxval = 5, step = 0.1, group = "止盈止损")
bool showSignals = input.bool(true, "显示入场候选", group = "显示")

if barstate.isfirst
    if not chart.is_standard or timeframe.in_seconds() != 60
        runtime.error("请使用标准蜡烛图、1 分钟周期。")
    if syminfo.prefix != "OKX" or (syminfo.ticker != "ETHUSDT.P" and syminfo.ticker != "BTCUSDT.P") or syminfo.pointvalue != 1
        runtime.error("本版适用于 OKX:ETHUSDT.P 或 OKX:BTCUSDT.P 的线性永续图表。")
    if minStopPercent > maxStopPercent
        runtime.error("最小止损距离不能大于最大止损距离。")

f_context() =>
    float trend = ta.ema(close, 40)
    float volatility = ta.atr(14)
    [dif, dea, histogram] = ta.macd(close, 10, 20, 5)
    [close[1], trend[1], trend[2], volatility[1], dif[1], dea[1], bar_index[1] + 1]

[hourClose, hourEma, hourPreviousEma, hourAtr, hourDif, hourDea, hourCount] = request.security(syminfo.tickerid, "60", f_context(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
[quarterClose, quarterEma, quarterPreviousEma, quarterAtr, quarterDif, quarterDea, quarterCount] = request.security(syminfo.tickerid, "15", f_context(), gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_on)
float ema5 = ta.ema(close, 5)
float ema10 = ta.ema(close, 10)
float ema20 = ta.ema(close, 20)
float ema40 = ta.ema(close, 40)
[dif, dea, histogram] = ta.macd(close, 10, 20, 5)
float hist = 2 * histogram
float atr = ta.atr(14)
float priorVolume = ta.sma(volume, 20)[1]
float vwap = ta.vwap(hlc3, timeframe.change("1D"))
bool ready = hourCount >= 60 and quarterCount >= 60 and bar_index >= 60 and hourAtr > 0 and quarterAtr > 0 and atr > 0 and priorVolume > 0
float hourSlope = (hourEma - hourPreviousEma) / hourAtr
float quarterSlope = (quarterEma - quarterPreviousEma) / quarterAtr
bool longTrend = ready and hourClose > hourEma and hourSlope > slopeThreshold and quarterClose > quarterEma and quarterSlope > slopeThreshold and hourDif > hourDea and hourDea > 0
bool shortTrend = ready and hourClose < hourEma and hourSlope < -slopeThreshold and quarterClose < quarterEma and quarterSlope < -slopeThreshold and hourDif < hourDea and hourDea < 0
bool emaUp = ta.crossover(ema5, ema10)
bool emaDown = ta.crossunder(ema5, ema10)
bool macdUp = ta.crossover(dif, dea)
bool macdDown = ta.crossunder(dif, dea)
int sinceEmaUp = ta.barssince(emaUp)
int sinceEmaDown = ta.barssince(emaDown)
int sinceMacdUp = ta.barssince(macdUp)
int sinceMacdDown = ta.barssince(macdDown)
// 回踩与放量触发可以分属不同的 K 线，回踩要求收盘守住 EMA40。
int sinceLongPullback = ta.barssince(low <= ema20 and close >= ema40 and volume < priorVolume)
int sinceShortPullback = ta.barssince(high >= ema20 and close <= ema40 and volume < priorVolume)
bool volumeOK = volume >= priorVolume * volumeMultiple
bool longTiming = close > ema40 and ema5 > ema10 and dif > dea and dea > 0 and hist > hist[1] and sinceEmaUp <= signalWindow and sinceMacdUp <= signalWindow and (emaUp or macdUp)
bool shortTiming = close < ema40 and ema5 < ema10 and dif < dea and dea < 0 and hist < hist[1] and sinceEmaDown <= signalWindow and sinceMacdDown <= signalWindow and (emaDown or macdDown)
bool longSetup = barstate.isconfirmed and longTrend and longTiming and sinceLongPullback <= pullbackWindow and volumeOK and (not useVwap or close > vwap)
bool shortSetup = barstate.isconfirmed and shortTrend and shortTiming and sinceShortPullback <= pullbackWindow and volumeOK and (not useVwap or close < vwap)

float recentLow = ta.lowest(low, swingLength)
float recentHigh = ta.highest(high, swingLength)
float longDistance = math.max(close - recentLow + atr * 0.2, math.max(atr * atrMultiple, close * minStopPercent / 100))
float shortDistance = math.max(recentHigh - close + atr * 0.2, math.max(atr * atrMultiple, close * minStopPercent / 100))

// 根据预计成交价分别计算多空成本。止盈用限价，止损计入设置的退出滑点。
f_plan(int direction, float distance) =>
    float fee = FEE_PERCENT / 100
    float slip = SLIPPAGE_TICKS * syminfo.mintick
    float entry = close + direction * slip
    int lossTicks = int(math.ceil(distance / syminfo.mintick))
    float lossDistance = lossTicks * syminfo.mintick
    float stopFill = entry - direction * (lossDistance + slip)
    float riskPerCoin = lossDistance + slip + fee * (entry + stopFill)
    float targetDistance = (netRR * riskPerCoin + 2 * fee * entry) / (1 - direction * fee)
    int profitTicks = int(math.ceil(targetDistance / syminfo.mintick))
    float targetFill = entry + direction * profitTicks * syminfo.mintick
    float netReward = profitTicks * syminfo.mintick - fee * (entry + targetFill)
    bool valid = ready and entry > 0 and stopFill > 0 and targetFill > 0 and lossDistance <= close * maxStopPercent / 100 and profitTicks * syminfo.mintick <= close * maxTargetPercent / 100 and netReward >= netRR * riskPerCoin
    [lossTicks, profitTicks, riskPerCoin, valid]

[longLossTicks, longProfitTicks, longRisk, longPlanOK] = f_plan(1, longDistance)
[shortLossTicks, shortProfitTicks, shortRisk, shortPlanOK] = f_plan(-1, shortDistance)
bool buySignal = longSetup and longPlanOK
bool sellSignal = shortSetup and shortPlanOK
plot(ema5, "一分钟 EMA5", color = color.white)
plot(ema10, "一分钟 EMA10", color = color.red)
plot(ema20, "一分钟 EMA20", color = color.aqua)
plot(ema40, "一分钟 EMA40", color = color.orange, linewidth = 2)
plot(useVwap ? vwap : na, "日内 VWAP", color = color.purple)
plotshape(showSignals and buySignal, title = "开多候选", text = "开多候选", style = shape.labelup, location = location.belowbar, color = color.green, textcolor = color.white, size = size.tiny)
plotshape(showSignals and sellSignal, title = "开空候选", text = "开空候选", style = shape.labeldown, location = location.abovebar, color = color.red, textcolor = color.white, size = size.tiny)
// 共同信号结束。

bool entriesEnabled = input.bool(true, "允许新开仓（关闭不停止退出）", group = "资金纪律")
float riskFraction = input.float(0.25, "单笔计划风险（权益 %）", minval = 0.05, maxval = 1, step = 0.05, group = "资金纪律") / 100
float budgetFraction = input.float(10, "单笔保证金及费用预算（权益 %）", minval = 1, maxval = 50, step = 1, group = "资金纪律") / 100
float quantityStep = input.float(0.001, "模拟币数量步长（自动向上对齐图表单位）", minval = 0.00000001, group = "资金纪律")
float dailyLossPercent = input.float(2, "当日亏损暂停阈值（权益 %，收盘检查）", minval = 0.5, maxval = 5, step = 0.5, group = "资金纪律")
int maxEntries = input.int(6, "每日最多开仓提交次数（UTC）", minval = 1, maxval = 30, group = "资金纪律")
int cooldownBars = input.int(5, "平仓后完整冷却根数", minval = 1, maxval = 60, group = "资金纪律")
int maxHoldBars = input.int(30, "最多持仓根数（收盘提交退出）", minval = 5, maxval = 120, group = "资金纪律")
bool showStatus = input.bool(true, "显示风险与交易状态", group = "显示")

int utcDay = int(math.floor(time / 86400000))
bool newDay = barstate.isfirst or utcDay != utcDay[1]
var float dayStartEquity = na
var bool dayHalted = false
var int entriesToday = 0
var int previousClosed = 0
var int lastExitBar = na
var int activeLossTicks = na
var int activeProfitTicks = na
var int longCandidates = 0
var int shortCandidates = 0
if newDay
    dayStartEquity := nz(strategy.equity[1], strategy.initial_capital)
    dayHalted := false
    entriesToday := 0
float dayLossPercent = dayStartEquity > 0 ? math.max(0, 100 * (dayStartEquity - strategy.equity) / dayStartEquity) : 100
if dayLossPercent >= dailyLossPercent or strategy.equity <= 0
    dayHalted := true
if strategy.closedtrades > previousClosed
    lastExitBar := bar_index
previousClosed := strategy.closedtrades
if strategy.position_size == 0
    activeLossTicks := na
    activeProfitTicks := na
if buySignal
    longCandidates += 1
if sellSignal
    shortCandidates += 1

bool coolingDown = not na(lastExitBar) and bar_index - lastExitBar <= cooldownBars
int heldBars = strategy.opentrades > 0 ? bar_index - strategy.opentrades.entry_bar_index(0) + 1 : 0
bool trendInvalid = (strategy.position_size > 0 and (hourClose < hourEma or quarterClose < quarterEma)) or (strategy.position_size < 0 and (hourClose > hourEma or quarterClose > quarterEma))
string status = not ready ? "历史数据不足" : "等待顺势回踩和量价触发"
int orderAction = 0
if barstate.isconfirmed
    // 退出分支优先；保护单保持到仓位关闭，不先撤保护再等待市价单。
    if strategy.position_size != 0
        if dayHalted
            strategy.close_all(comment = "日内亏损暂停平仓", alert_message = "日内亏损阈值触发：平掉模拟仓位，当日暂停开仓")
            status := "已提交日内风控平仓"
        else if heldBars >= maxHoldBars
            strategy.close_all(comment = "持仓超时平仓", alert_message = "达到最长持仓时间：平掉模拟仓位")
            status := "已提交超时平仓"
        else if trendInvalid
            strategy.close_all(comment = "大级别失效平仓", alert_message = "已收盘大级别价格穿越 EMA40：平掉模拟仓位")
            status := "已提交趋势失效平仓"
        else
            status := "持仓，固定止盈止损有效"
    else if dayHalted
        status := "当日亏损暂停，等待 UTC 次日"
    else if coolingDown
        status := "平仓冷却中"
    else if not entriesEnabled
        status := "已暂停新开仓"
    else if entriesToday >= maxEntries
        status := "已达到当日开仓次数上限"
    else if buySignal or sellSignal
        int direction = buySignal ? 1 : -1
        int lossTicks = buySignal ? longLossTicks : shortLossTicks
        int profitTicks = buySignal ? longProfitTicks : shortProfitTicks
        float riskPerCoin = buySignal ? longRisk : shortRisk
        float equity = math.max(strategy.equity, 0)
        float referencePrice = close + SLIPPAGE_TICKS * syminfo.mintick
        float riskQty = equity * riskFraction / (riskPerCoin * syminfo.pointvalue)
        float marginQty = equity * budgetFraction / (referencePrice * syminfo.pointvalue * (MARGIN_PERCENT / 100 + 2 * FEE_PERCENT / 100))
        float step = math.ceil(quantityStep / syminfo.mincontract) * syminfo.mincontract
        float quantity = math.floor(math.min(riskQty, marginQty) / step) * step
        if quantity > 0
            activeLossTicks := lossTicks
            activeProfitTicks := profitTicks
            if direction == 1
                strategy.entry("做多", strategy.long, qty = quantity, comment = "顺势买入开多", alert_message = "买入开多：一分钟顺势执行信号")
                strategy.exit("多单止盈止损", from_entry = "做多", loss = lossTicks, profit = profitTicks, comment_loss = "多单止损", comment_profit = "多单止盈", alert_loss = "卖出平多：固定止损成交", alert_profit = "卖出平多：固定止盈成交")
            else
                strategy.entry("做空", strategy.short, qty = quantity, comment = "顺势卖出开空", alert_message = "卖出开空：一分钟顺势执行信号")
                strategy.exit("空单止盈止损", from_entry = "做空", loss = lossTicks, profit = profitTicks, comment_loss = "空单止损", comment_profit = "空单止盈", alert_loss = "买入平空：固定止损成交", alert_profit = "买入平空：固定止盈成交")
            entriesToday += 1
            orderAction := direction
            status := direction == 1 ? "已提交开多及止盈止损" : "已提交开空及止盈止损"
        else
            status := "资金预算不足，数量取整为零"
    else if longSetup or shortSetup
        status := "止损或目标距离超限，不入场"

float positionDirection = math.sign(strategy.position_size)
float stopPrice = strategy.position_size != 0 ? strategy.position_avg_price - positionDirection * activeLossTicks * syminfo.mintick : na
float targetPrice = strategy.position_size != 0 ? strategy.position_avg_price + positionDirection * activeProfitTicks * syminfo.mintick : na
float exposure = strategy.equity > 0 ? math.abs(strategy.position_size) * close * syminfo.pointvalue / strategy.equity : na
plot(stopPrice, "本笔固定止损", color = color.red, linewidth = 2, style = plot.style_linebr)
plot(targetPrice, "本笔固定止盈", color = color.lime, linewidth = 2, style = plot.style_linebr)
plot(orderAction, "开仓提交方向（多一空负一）", display = display.data_window)
plot(dayLossPercent, "当日收盘权益亏损百分比", display = display.data_window)
plot(strategy.closedtrades, "累计已平仓笔数", display = display.data_window)
var table panel = table.new(position.top_right, 2, 10, bgcolor = color.new(color.black, 15), border_width = 1)
if barstate.islast or barstate.islastconfirmedhistory
    if showStatus
        string trendText = not ready ? "预热中" : longTrend ? "只找做多" : shortTrend ? "只找做空" : "方向不一致或走平，观望"
        table.cell(panel, 0, 0, "大级别结论", text_color = color.white)
        table.cell(panel, 1, 0, trendText, text_color = longTrend ? color.lime : shortTrend ? color.red : color.orange)
        table.cell(panel, 0, 1, "本根处理", text_color = color.white)
        table.cell(panel, 1, 1, status, text_color = color.white)
        table.cell(panel, 0, 2, "模拟仓位（币）", text_color = color.white)
        table.cell(panel, 1, 2, str.tostring(strategy.position_size, "#.########"), text_color = color.white)
        table.cell(panel, 0, 3, "止损 / 止盈", text_color = color.white)
        table.cell(panel, 1, 3, na(stopPrice) ? "空仓" : str.tostring(stopPrice, format.mintick) + " / " + str.tostring(targetPrice, format.mintick), text_color = color.white)
        table.cell(panel, 0, 4, "计划风险 / 目标净盈亏比", text_color = color.white)
        table.cell(panel, 1, 4, str.tostring(riskFraction * 100, "#.##") + "% / " + str.tostring(netRR, "#.#"), text_color = color.white)
        table.cell(panel, 0, 5, "日内亏损 / 暂停阈值", text_color = color.white)
        table.cell(panel, 1, 5, str.tostring(dayLossPercent, "#.##") + "% / " + str.tostring(dailyLossPercent, "#.#") + "%", text_color = color.white)
        table.cell(panel, 0, 6, "当日开仓提交 / 上限", text_color = color.white)
        table.cell(panel, 1, 6, str.tostring(entriesToday) + " / " + str.tostring(maxEntries), text_color = color.white)
        table.cell(panel, 0, 7, "累计候选 多 / 空", text_color = color.white)
        table.cell(panel, 1, 7, str.tostring(longCandidates) + " / " + str.tostring(shortCandidates), text_color = color.white)
        table.cell(panel, 0, 8, "已平仓 / 已持仓根数", text_color = color.white)
        table.cell(panel, 1, 8, str.tostring(strategy.closedtrades) + " / " + str.tostring(heldBars), text_color = color.white)
        table.cell(panel, 0, 9, "当前名义仓位 / 权益", text_color = color.white)
        table.cell(panel, 1, 9, str.tostring(exposure, "#.##") + " 倍", text_color = color.white)
    else
        table.clear(panel, 0, 0, 1, 9)
